<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AdServer dashboard</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, sans-serif; color: #203431; background: #f4f7f6; }
    * { box-sizing: border-box; }
    body { margin: 0; }
    main { max-width: 1200px; margin: auto; padding: 48px 24px; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
    h1 { font-size: 2rem; letter-spacing: -.04em; margin: 0; }
    h2 { font-size: 1.2rem; margin: 0; }
    p { color: #526662; line-height: 1.6; }
    .eyebrow { color: #176b58; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .refresh { color: #176b58; background: white; border: 1px solid #c6d7d1; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; }
    a:focus-visible { outline: 3px solid #176b58; outline-offset: 4px; }
    .graph { margin: 28px 0; padding: 24px; }
    .graph form { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; margin: 20px 0; }
    .graph label { display: block; font-size: .9rem; }
    .graph select, .graph input[type=date], .graph button { padding: 9px; border: 1px solid #c6d7d1; border-radius: 6px; background: white; color: #203431; font: inherit; max-width: 100%; }
    .graph select { width: 340px; }
    .graph fieldset { border: 0; padding: 0; margin: 0; }
    .graph fieldset label { display: inline-block; padding: 8px; }
    .graph svg { width: 100%; height: auto; min-height: 190px; }
    .graph summary { cursor: pointer; padding: 12px 0; }
    .graph .table-scroll { max-height: 300px; }
    .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 30px 0; }
    .card, .panel { background: white; border: 1px solid #dce5e1; border-radius: 12px; }
    .card { padding: 24px; }
    .card dt { font-size: .85rem; color: #526662; }
    .card dd { font-size: 2rem; margin: 10px 0 0; font-weight: 650; font-variant-numeric: tabular-nums; }
    .panel-heading { padding: 24px; border-bottom: 1px solid #e7edeb; }
    .panel-heading p { margin: 6px 0 0; font-size: .9rem; }
    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    th, td { text-align: left; padding: 16px 24px; border-bottom: 1px solid #edf1ef; }
    th { color: #526662; background: #fafcfb; font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; }
    .number { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .badge { display: inline-block; border-radius: 20px; background: #edf1ef; padding: 4px 10px; font-size: .75rem; white-space: nowrap; }
    .live { background: #e2f4ec; color: #176b58; }
    .empty { text-align: center; padding: 48px 24px; }
    footer { margin-top: 22px; color: #526662; font-size: .8rem; line-height: 1.6; }
    @media (max-width: 700px) { main { padding: 28px 16px; } .cards { grid-template-columns: repeat(2, 1fr); } .card { padding: 18px; } th, td { padding: 14px; } }
  </style>
</head>
<body>
<main>
  <header>
    <div><p class="eyebrow">AdServer · Overview</p><h1>Your ads at a glance</h1><p>All-time activity across clients and campaigns.</p></div>
    <a class="refresh" href="">Refresh</a>
  </header>
  <section class="panel graph" aria-labelledby="activity-heading">
    <h2 id="activity-heading">Daily activity</h2>
    <form id="graph-form" data-endpoint="<% request.uri_base | html %>/dashboard/graph">
      <fieldset><legend>Measure</legend>
        <label><input type="radio" name="metric" value="impressions" checked> Impressions</label>
        <label><input type="radio" name="metric" value="clicks"> Clicks</label>
      </fieldset>
      <label>Graph filter<br><select name="scope"><option value="all">All ads</option></select></label>
      <label>From<br><input type="date" name="from" required></label>
      <label>Through<br><input type="date" name="to" required></label>
      <button type="submit">Update graph</button>
    </form>
    <p id="graph-status" role="status" aria-live="polite">Loading graph…</p>
    <div id="graph-output"></div>
    <noscript><p>Enable JavaScript to view the daily graph.</p></noscript>
    <script src="<% request.uri_base | html %>/javascripts/dashboard.js" defer></script>
    <p>Filters apply to this graph. All-time totals and ad performance below include all ads.</p>
  </section>
  <dl class="cards">
    <div class="card"><dt>Impressions</dt><dd><% stats.impressions %></dd></div>
    <div class="card"><dt>Clicks</dt><dd><% stats.clicks %></dd></div>
    <div class="card"><dt>Click-through rate</dt><dd><% stats.ctr %>%</dd></div>
    <div class="card"><dt>Ads serving</dt><dd><% stats.serving_count %> / <% stats.ad_count %></dd></div>
  </dl>
  <section class="panel" aria-labelledby="ads-heading">
    <div class="panel-heading"><h2 id="ads-heading">Ad performance</h2><p>Includes inactive ads and their historical activity.</p></div>
    <% IF stats.ads.size %>
    <div class="table-scroll">
      <table aria-label="All-time ad performance">
        <thead><tr><th scope="col">Ad</th><th scope="col">Client</th><th scope="col">Campaign</th><th scope="col">Status</th><th scope="col" class="number">Impressions</th><th scope="col" class="number">Clicks</th><th scope="col" class="number">CTR</th></tr></thead>
        <tbody><% FOREACH ad IN stats.ads %>
          <tr><td><% ad.name | html %></td><td><% ad.client_name | html %></td><td><% ad.campaign_name | html %></td><td><% IF ad.serving %><span class="badge live">Serving</span><% ELSE %><span class="badge">Inactive</span><% END %></td><td class="number"><% ad.impressions %></td><td class="number"><% ad.clicks %></td><td class="number"><% ad.ctr %>%</td></tr>
        <% END %></tbody>
      </table>
    </div>
    <% ELSE %><div class="empty"><h2>No ads yet</h2><p>Add a client, campaign, and ad to start seeing performance here.</p></div><% END %>
  </section>
  <footer>CTR = clicks ÷ impressions. Repeated clicks count separately; CTR can exceed 100%. With no impressions, CTR displays 0.00%. Totals include historical events without an ad.<br>Figures update when you refresh. AdServer <% version | html %></footer>
</main>
</body>
</html>
